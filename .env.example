# Copy this file to .env and fill in your own values. .env is git-ignored.
# Only needed for the OPTIONAL python/upload_to_stage.py script.

SNOWFLAKE_ACCOUNT=xy12345.us-east-1     # Snowsight > your name (bottom-left) > Account > copy account identifier
SNOWFLAKE_USER=YOUR_USERNAME
SNOWFLAKE_PASSWORD=
# If your account enforces MFA, set the authenticator below and approve the push on your phone.
# SNOWFLAKE_AUTHENTICATOR=username_password_mfa
SNOWFLAKE_ROLE=SYSADMIN
SNOWFLAKE_WAREHOUSE=CRI_WH
SNOWFLAKE_DATABASE=CRI_DB
SNOWFLAKE_SCHEMA=RAW
