# Copy this file to .env and fill in your own values. .env is git-ignored.
# Used by the Python scripts (python/upload_to_stage.py and python/run_sprint3.py).

SNOWFLAKE_ACCOUNT=orgname-accountname          # from your Snowsight URL: app.snowflake.com/<org>/<account>
SNOWFLAKE_USER=YOUR_USERNAME
SNOWFLAKE_PRIVATE_KEY_PATH=/Users/you/.snowflake/keys/rsa_key.p8   # key-pair login (see README, Sprint 2)
SNOWFLAKE_ROLE=SYSADMIN
SNOWFLAKE_WAREHOUSE=CRI_WH
SNOWFLAKE_DATABASE=CRI_DB
