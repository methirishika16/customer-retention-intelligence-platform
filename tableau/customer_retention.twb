          <datasources><datasource caption='customers' name='federated.customers' /><datasource name='Parameters' /></datasources>
          <datasource-dependencies datasource='Parameters'><column caption='Marketing Budget (R$)' datatype='real' name='[Parameter 1]' param-domain-type='range' role='measure' type='quantitative' value='25000.'><calculation class='tableau' formula='25000.' /><range granularity='5000.' max='200000.' min='0.' /></column></datasource-dependencies>
          <datasource-dependencies datasource='federated.customers'><column caption="Priority Rank" datatype='integer' name='[priority_rank]' role='measure' type='quantitative' /><column caption="Customer" datatype='string' name='[Calculation_customer_short_id]' role='dimension' type='nominal'><calculation class='tableau' formula="LEFT([customer_unique_id], 8)" /></column><column caption="Customer State" datatype='string' name='[customer_state]' role='dimension' type='nominal' /><column caption="Customer Group" datatype='string' name='[customer_group]' role='dimension' type='nominal' /><column caption="Next Best Action" datatype='string' name='[next_best_action]' role='dimension' type='nominal' /><column caption="Return Probability %" datatype='real' name='[Calculation_return_prob_pct]' role='dimension' type='ordinal'><calculation class='tableau' formula="ROUND(100 * [return_probability], 2)" /></column><column caption="Priority Score" datatype='real' name='[priority_score]' role='measure' type='quantitative' /><column caption="Within Budget" datatype='boolean' name='[Calculation_within_budget]' role='dimension' type='nominal'><calculation class='tableau' formula="[cumulative_action_cost_brl] &lt;= [Parameters].[Parameter 1]" /></column><column caption="Customer Unique Id" datatype='string' name='[customer_unique_id]' role='dimension' type='nominal' /><column caption="Return Probability" datatype='real' name='[return_probability]' role='measure' type='quantitative' /><column caption="Cumulative Action Cost Brl" datatype='real' name='[cumulative_action_cost_brl]' role='measure' type='quantitative' /><column-instance column='[priority_rank]' derivation='None' name='[none:priority_rank:ok]' pivot='key' type='ordinal' /><column-instance column='[Calculation_customer_short_id]' derivation='None' name='[none:Calculation_customer_short_id:nk]' pivot='key' type='nominal' /><column-instance column='[customer_state]' derivation='None' name='[none:customer_state:nk]' pivot='key' type='nominal' /><column-instance column='[customer_group]' derivation='None' name='[none:customer_group:nk]' pivot='key' type='nominal' /><column-instance column='[next_best_action]' derivation='None' name='[none:next_best_action:nk]' pivot='key' type='nominal' /><column-instance column='[Calculation_return_prob_pct]' derivation='None' name='[none:Calculation_return_prob_pct:ok]' pivot='key' type='ordinal' /><column-instance column='[priority_score]' derivation='Sum' name='[sum:priority_score:qk]' pivot='key' type='quantitative' /><column-instance column='[Calculation_within_budget]' derivation='None' name='[none:Calculation_within_budget:nk]' pivot='key' type='nominal' /><column-instance column='[priority_rank]' derivation='None' name='[none:priority_rank:qk]' pivot='key' type='quantitative' /></datasource-dependencies>
          <filter class='categorical' column='[federated.customers].[none:Calculation_within_budget:nk]'><groupfilter function='member' level='[none:Calculation_within_budget:nk]' member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' /></filter><filter class='quantitative' column='[federated.customers].[none:priority_rank:qk]' included-values='in-range'><min>1</min><max>100</max></filter>
          
          <slices><column>[federated.customers].[none:Calculation_within_budget:nk]</column><column>[federated.customers].[none:priority_rank:qk]</column></slices>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view><breakdown value='auto' /></view>
            <mark class='Text' />
            
            <encodings><text column='[federated.customers].[sum:priority_score:qk]' /></encodings>
            <style><style-rule element='mark'><format attr='mark-color' value='#2a78d6' /></style-rule></style>
          </pane>
        </panes>
        <rows>[federated.customers].[none:priority_rank:ok] / [federated.customers].[none:Calculation_customer_short_id:nk] / [federated.customers].[none:customer_state:nk] / [federated.customers].[none:customer_group:nk] / [federated.customers].[none:next_best_action:nk] / [federated.customers].[none:Calculation_return_prob_pct:ok]</rows>
        <cols></cols>
      </table>
    </worksheet>
    <worksheet name="6.1 Model lift by decile">
      <table>
        <view>
          <datasources><datasource caption='model_lift_by_decile' name='federated.modelliftbydecile' /></datasources>
          
          <datasource-dependencies datasource='federated.modelliftbydecile'><column caption="Lift" datatype='real' name='[lift]' role='measure' type='quantitative' /><column caption="Decile" datatype='integer' name='[decile]' role='measure' type='quantitative' /><column-instance column='[lift]' derivation='Sum' name='[sum:lift:qk]' pivot='key' type='quantitative' /><column-instance column='[decile]' derivation='None' name='[none:decile:ok]' pivot='key' type='ordinal' /></datasource-dependencies>
          
          
          
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view><breakdown value='auto' /></view>
            <mark class='Bar' />
            
            <encodings><text column='[federated.modelliftbydecile].[sum:lift:qk]' /></encodings>
            <style><style-rule element='mark'><format attr='mark-color' value='#2a78d6' /><format attr='mark-labels-show' value='true' /></style-rule></style>
          </pane>
        </panes>
        <rows>[federated.modelliftbydecile].[sum:lift:qk]</rows>
        <cols>[federated.modelliftbydecile].[none:decile:ok]</cols>
      </table>
    </worksheet>
  </worksheets>
  <dashboards>
    <dashboard name="Executive Overview">
      <style />
      <size maxheight='800' maxwidth='1200' minheight='800' minwidth='1200' />
      <zones><zone h='100000' id='1' type-v2='layout-basic' w='100000' x='0' y='0' /><zone h='4250' id='2' type-v2='text' w='96667' x='1667' y='1500'><formatted-text><run bold='true' fontcolor='#0b0b0b' fontsize='18'>Customer Retention Intelligence: Executive Overview</run></formatted-text></zone><zone h='2750' id='3' type-v2='text' w='96667' x='1667' y='5500'><formatted-text><run fontcolor='#52514e' fontsize='11'>Olist marketplace · valid purchases Sep 2016 – Aug 2018 · revenue in BRL</run></formatted-text></zone><zone h='2750' id='4' type-v2='text' w='96667' x='1667' y='8750'><formatted-text><run fontcolor='#2a78d6' fontsize='10'>[Executive Overview]   ·   Customer Segmentation   ·   Retention Intelligence   ·   Growth Opportunities   ·   Marketing Prioritization   ·   Model Card</run></formatted-text></zone><zone h='12500' id='5' name="1.1a KPI Revenue" show-title='false' w='15417' x='1667' y='13750' /><zone h='12500' id='6' name="1.1b KPI Orders" show-title='false' w='15417' x='17917' y='13750' /><zone h='12500' id='7' name="1.1c KPI Customers" show-title='false' w='15417' x='34167' y='13750' /><zone h='12500' id='8' name="1.1d KPI AOV" show-title='false' w='15417' x='50417' y='13750' /><zone h='12500' id='9' name="1.1e KPI Repeat" show-title='false' w='15417' x='66667' y='13750' /><zone h='12500' id='10' name="1.1f KPI High Value" show-title='false' w='15417' x='82917' y='13750' /><zone h='33750' id='11' name="1.2 Monthly revenue" show-title='true' w='96667' x='1667' y='28125' /><zone h='33750' id='12' name="1.3 New customers per month" show-title='true' w='47917' x='1667' y='63125' /><zone h='33750' id='13' name="1.4 Returning customer share" show-title='true' w='47917' x='50417' y='63125' /><zone h='2750' id='14' type-v2='text' w='96667' x='1667' y='97000'><formatted-text><run fontcolor='#52514e' fontsize='9'>Returning customers grew from ~0.1% to ~3% of monthly buyers, still a small minority. Low-volume months (2016-09, 2016-12, 2018-09) are excluded.</run></formatted-text></zone></zones>
    </dashboard>
    <dashboard name="Customer Segmentation">
      <style />
      <size maxheight='800' maxwidth='1200' minheight='800' minwidth='1200' />
      <zones><zone h='100000' id='1' type-v2='layout-basic' w='100000' x='0' y='0' /><zone h='4250' id='2' type-v2='text' w='96667' x='1667' y='1500'><formatted-text><run bold='true' fontcolor='#0b0b0b' fontsize='18'>Who Are Our Customers?</run></formatted-text></zone><zone h='2750' id='3' type-v2='text' w='96667' x='1667' y='5500'><formatted-text><run fontcolor='#52514e' fontsize='11'>RFM segments, value distribution and lifecycle stage · 94,990 customers as of 2018-09-03</run></formatted-text></zone><zone h='2750' id='4' type-v2='text' w='96667' x='1667' y='8750'><formatted-text><run fontcolor='#2a78d6' fontsize='10'>Executive Overview   ·   [Customer Segmentation]   ·   Retention Intelligence   ·   Growth Opportunities   ·   Marketing Prioritization   ·   Model Card</run></formatted-text></zone><zone h='42500' id='5' name="2.1 RFM segments" show-title='true' w='48333' x='1667' y='13750' /><zone h='42500' id='6' name="2.2 Recency x Monetary" show-title='true' w='47500' x='50833' y='13750' /><zone h='38750' id='7' name="2.3 Value distribution" show-title='true' w='48333' x='1667' y='57500' /><zone h='38750' id='8' name="2.4 Lifecycle stage" show-title='true' w='47500' x='50833' y='57500' /><zone h='4250' id='9' mode='checkdropdown' name='2.1 RFM segments' param='[federated.customers].[none:customer_state:nk]' type-v2='filter' w='23333' x='75000' y='8750' /><zone h='2750' id='10' type-v2='text' w='96667' x='1667' y='97000'><formatted-text><run fontcolor='#52514e' fontsize='9'>Recency (R) and Monetary (M) scores run 1-5 (5 = best). Frequency is omitted from the matrix: 97.8% of customers bought once.</run></formatted-text></zone></zones>
    </dashboard>
    <dashboard name="Retention Intelligence">
      <style />
      <size maxheight='800' maxwidth='1200' minheight='800' minwidth='1200' />
      <zones><zone h='100000' id='1' type-v2='layout-basic' w='100000' x='0' y='0' /><zone h='4250' id='2' type-v2='text' w='96667' x='1667' y='1500'><formatted-text><run bold='true' fontcolor='#0b0b0b' fontsize='18'>Who Is Slipping Away?</run></formatted-text></zone><zone h='2750' id='3' type-v2='text' w='96667' x='1667' y='5500'><formatted-text><run fontcolor='#52514e' fontsize='11'>Predicted return likelihood, high-value customers at risk and cohort retention</run></formatted-text></zone><zone h='2750' id='4' type-v2='text' w='96667' x='1667' y='8750'><formatted-text><run fontcolor='#2a78d6' fontsize='10'>Executive Overview   ·   Customer Segmentation   ·   [Retention Intelligence]   ·   Growth Opportunities   ·   Marketing Prioritization   ·   Model Card</run></formatted-text></zone><zone h='37500' id='5' name="3.1 Risk distribution" show-title='true' w='30833' x='1667' y='13750' /><zone h='37500' id='6' name="3.2 Value x risk" show-title='true' w='31667' x='33333' y='13750' /><zone h='37500' id='7' name="3.3 Activity by value tier" show-title='true' w='32500' x='65833' y='13750' /><zone h='43750' id='8' name="3.4 Cohort retention" show-title='true' w='96667' x='1667' y='52500' /><zone h='2750' id='9' type-v2='text' w='96667' x='1667' y='97000'><formatted-text><run fontcolor='#52514e' fontsize='9'>Risk tiers rank customers by the model's predicted chance of buying again within 180 days. No customer is labelled 'churned': the data has no churn event.</run></formatted-text></zone></zones>
    </dashboard>
    <dashboard name="Growth Opportunities">
      <style />
      <size maxheight='800' maxwidth='1200' minheight='800' minwidth='1200' />
      <zones><zone h='100000' id='1' type-v2='layout-basic' w='100000' x='0' y='0' /><zone h='4250' id='2' type-v2='text' w='96667' x='1667' y='1500'><formatted-text><run bold='true' fontcolor='#0b0b0b' fontsize='18'>Where Is the Opportunity?</run></formatted-text></zone><zone h='2750' id='3' type-v2='text' w='96667' x='1667' y='5500'><formatted-text><run fontcolor='#52514e' fontsize='11'>Retention groups, recommended next-best actions and category performance</run></formatted-text></zone><zone h='2750' id='4' type-v2='text' w='96667' x='1667' y='8750'><formatted-text><run fontcolor='#2a78d6' fontsize='10'>Executive Overview   ·   Customer Segmentation   ·   Retention Intelligence   ·   [Growth Opportunities]   ·   Marketing Prioritization   ·   Model Card</run></formatted-text></zone><zone h='42500' id='5' name="4.1 Opportunity map" show-title='true' w='48333' x='1667' y='13750' /><zone h='42500' id='6' name="4.2 Next best actions" show-title='true' w='47500' x='50833' y='13750' /><zone h='38750' id='7' name="4.3 Category performance" show-title='true' w='96667' x='1667' y='57500' /><zone h='2750' id='8' type-v2='text' w='96667' x='1667' y='97000'><formatted-text><run fontcolor='#52514e' fontsize='9'>Bubble size = customers. Category colour = average review score (low scores stand out). Expected revenue figures are model estimates if no action is taken.</run></formatted-text></zone></zones>
    </dashboard>
    <dashboard name="Marketing Prioritization">
      <style />
      <size maxheight='800' maxwidth='1200' minheight='800' minwidth='1200' />
      <zones><zone h='100000' id='1' type-v2='layout-basic' w='100000' x='0' y='0' /><zone h='4250' id='2' type-v2='text' w='96667' x='1667' y='1500'><formatted-text><run bold='true' fontcolor='#0b0b0b' fontsize='18'>Who Should We Contact First?</run></formatted-text></zone><zone h='2750' id='3' type-v2='text' w='96667' x='1667' y='5500'><formatted-text><run fontcolor='#52514e' fontsize='11'>Customers ranked by priority score · move the budget slider · action costs are illustrative</run></formatted-text></zone><zone h='2750' id='4' type-v2='text' w='96667' x='1667' y='8750'><formatted-text><run fontcolor='#2a78d6' fontsize='10'>Executive Overview   ·   Customer Segmentation   ·   Retention Intelligence   ·   Growth Opportunities   ·   [Marketing Prioritization]   ·   Model Card</run></formatted-text></zone><zone h='12500' id='5' name="5.2a KPI Reached" show-title='false' w='17500' x='26667' y='13750' /><zone h='12500' id='6' name="5.2b KPI Spend" show-title='false' w='17500' x='45000' y='13750' /><zone h='12500' id='7' name="5.2c KPI High Value" show-title='false' w='17500' x='63333' y='13750' /><zone h='12500' id='8' name="5.2d KPI Revenue Share" show-title='false' w='16667' x='81667' y='13750' /><zone h='31250' id='9' name="5.3 Budget curve" show-title='true' w='48333' x='1667' y='27500' /><zone h='31250' id='10' name="5.4 Actions in budget" show-title='true' w='47500' x='50833' y='27500' /><zone h='36250' id='11' name="5.5 Priority list" show-title='true' w='96667' x='1667' y='60000' /><zone h='12500' id='12' mode='slider' param='[Parameters].[Parameter 1]' type-v2='paramctrl' w='24167' x='1667' y='13750' /><zone h='2750' id='13' type-v2='text' w='96667' x='1667' y='97000'><formatted-text><run fontcolor='#52514e' fontsize='9'>Priority = 45% value + 35% predicted return likelihood + 20% urgency. The effect of each action must be measured with an A/B test.</run></formatted-text></zone></zones>
    </dashboard>
    <dashboard name="Model Card">
      <style />
      <size maxheight='800' maxwidth='1200' minheight='800' minwidth='1200' />
      <zones><zone h='100000' id='1' type-v2='layout-basic' w='100000' x='0' y='0' /><zone h='4250' id='2' type-v2='text' w='96667' x='1667' y='1500'><formatted-text><run bold='true' fontcolor='#0b0b0b' fontsize='18'>How Good Is the Model?</run></formatted-text></zone><zone h='2750' id='3' type-v2='text' w='96667' x='1667' y='5500'><formatted-text><run fontcolor='#52514e' fontsize='11'>Out-of-time test: customers as of 2018-03-01, did they buy again within 180 days?</run></formatted-text></zone><zone h='2750' id='4' type-v2='text' w='96667' x='1667' y='8750'><formatted-text><run fontcolor='#2a78d6' fontsize='10'>Executive Overview   ·   Customer Segmentation   ·   Retention Intelligence   ·   Growth Opportunities   ·   Marketing Prioritization   ·   [Model Card]</run></formatted-text></zone><zone h='65000' id='5' name="6.1 Model lift by decile" show-title='true' w='96667' x='1667' y='13750' /><zone h='2750' id='6' type-v2='text' w='96667' x='1667' y='97000'><formatted-text><run fontcolor='#52514e' fontsize='9'>ROC-AUC 0.586 (random 0.519). Top 10% lift 2.0x vs 1.9x for an RFM rule and 1.5x for 'most recent first'. Use scores to rank customers, not as exact probabilities.</run></formatted-text></zone></zones>
    </dashboard>
  </dashboards>
