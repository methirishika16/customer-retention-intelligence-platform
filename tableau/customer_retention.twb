      </table>
    </worksheet>
    <worksheet name="1.1e KPI Repeat">
      <table>
        <view>
          <datasources><datasource caption='customers' name='federated.customers' /></datasources>
          
          <datasource-dependencies datasource='federated.customers'><column caption="KPI Repeat Rate %" datatype='real' name='[Calculation_kpi_repeat_pct]' role='measure' type='quantitative'><calculation class='tableau' formula="ROUND(100 * SUM(IIF([order_count] &gt;= 2, 1, 0)) / COUNT([customer_unique_id]), 2)" /></column><column caption="Customer Unique Id" datatype='string' name='[customer_unique_id]' role='dimension' type='nominal' /><column caption="Order Count" datatype='integer' name='[order_count]' role='measure' type='quantitative' /><column-instance column='[Calculation_kpi_repeat_pct]' derivation='User' name='[usr:Calculation_kpi_repeat_pct:qk]' pivot='key' type='quantitative' /></datasource-dependencies>
          
          
          
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view><breakdown value='auto' /></view>
            <mark class='Text' />
            <customized-label><formatted-text><run fontcolor='#52514e' fontsize='11'>Repeat purchase rate</run><run>Æ&#10;</run><run fontcolor='#0b0b0b' fontsize='26'></run><run bold='true' fontcolor='#0b0b0b' fontsize='26'>&lt;[federated.customers].[usr:Calculation_kpi_repeat_pct:qk]&gt;</run><run fontcolor='#0b0b0b' fontsize='26'>%</run></formatted-text></customized-label>
            <encodings><text column='[federated.customers].[usr:Calculation_kpi_repeat_pct:qk]' /></encodings>
            <style><style-rule element='mark'><format attr='mark-color' value='#2a78d6' /></style-rule></style>
          </pane>
        </panes>
        <rows></rows>
        <cols></cols>
      </table>
    </worksheet>
    <worksheet name="1.1f KPI High Value">
      <table>
        <view>
          <datasources><datasource caption='customers' name='federated.customers' /></datasources>
          
          <datasource-dependencies datasource='federated.customers'><column caption="KPI High-Value Customers" datatype='integer' name='[Calculation_kpi_high_value]' role='measure' type='quantitative'><calculation class='tableau' formula="SUM(IIF([value_tier] = 'High', 1, 0))" /></column><column caption="KPI High-Value Revenue %" datatype='real' name='[Calculation_kpi_high_value_rev_pct]' role='measure' type='quantitative'><calculation class='tableau' formula="ROUND(100 * SUM(IIF([value_tier] = 'High', [total_revenue], 0)) / SUM([total_revenue]), 1)" /></column><column caption="Value Tier" datatype='string' name='[value_tier]' role='dimension' type='nominal' /><column caption="Total Revenue" datatype='real' name='[total_revenue]' role='measure' type='quantitative' /><column-instance column='[Calculation_kpi_high_value]' derivation='User' name='[usr:Calculation_kpi_high_value:qk]' pivot='key' type='quantitative' /><column-instance column='[Calculation_kpi_high_value_rev_pct]' derivation='User' name='[usr:Calculation_kpi_high_value_rev_pct:qk]' pivot='key' type='quantitative' /></datasource-dependencies>
          
          
          
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view><breakdown value='auto' /></view>
            <mark class='Text' />
            <customized-label><formatted-text><run fontcolor='#52514e' fontsize='11'>High-value customers</run><run>Æ&#10;</run><run fontcolor='#0b0b0b' fontsize='26'></run><run bold='true' fontcolor='#0b0b0b' fontsize='26'>&lt;[federated.customers].[usr:Calculation_kpi_high_value:qk]&gt;</run><run fontcolor='#0b0b0b' fontsize='26'></run><run>Æ&#10;</run><run fontcolor='#52514e' fontsize='10'></run><run bold='true' fontcolor='#0b0b0b' fontsize='26'>&lt;[federated.customers].[usr:Calculation_kpi_high_value_rev_pct:qk]&gt;</run><run fontcolor='#52514e' fontsize='10'>% of revenue</run></formatted-text></customized-label>
            <encodings><text column='[federated.customers].[usr:Calculation_kpi_high_value:qk]' /><text column='[federated.customers].[usr:Calculation_kpi_high_value_rev_pct:qk]' /></encodings>
            <style><style-rule element='mark'><format attr='mark-color' value='#2a78d6' /></style-rule></style>
          </pane>
        </panes>
        <rows></rows>
        <cols></cols>
      </table>
    </worksheet>
    <worksheet name="1.2 Monthly revenue">
      <table>
        <view>
          <datasources><datasource caption='monthly_revenue' name='federated.monthlyrevenue' /></datasources>
          
          <datasource-dependencies datasource='federated.monthlyrevenue'><column caption="Revenue (R$ K)" datatype='real' name='[Calculation_revenue_k]' role='measure' type='quantitative'><calculation class='tableau' formula="SUM([revenue]) / 1000" /></column><column caption="Purchase Month" datatype='date' name='[purchase_month]' role='dimension' type='ordinal' /><column caption="Is Low Volume Month" datatype='boolean' name='[is_low_volume_month]' role='dimension' type='nominal' /><column caption="Revenue" datatype='real' name='[revenue]' role='measure' type='quantitative' /><column-instance column='[Calculation_revenue_k]' derivation='User' name='[usr:Calculation_revenue_k:qk]' pivot='key' type='quantitative' /><column-instance column='[purchase_month]' derivation='Month-Trunc' name='[tmn:purchase_month:qk]' pivot='key' type='quantitative' /><column-instance column='[is_low_volume_month]' derivation='None' name='[none:is_low_volume_month:nk]' pivot='key' type='nominal' /></datasource-dependencies>
