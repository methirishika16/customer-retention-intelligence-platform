<?xml version='1.0' encoding='utf-8' ?>
<workbook original-version='18.1' source-build='2024.2.0 (20242.24.0613.0835)' source-platform='mac' version='18.1' xmlns:user='http://www.tableausoftware.com/xml/user'>
  <preferences>
    <preference name='ui.encoding.shelf.height' value='24' />
    <preference name='ui.shelf.height' value='26' />
  </preferences>
  <datasources><datasource hasconnection='false' inline='true' name='Parameters' version='18.1'><aliases enabled='yes' /><column caption='Marketing Budget (R$)' datatype='real' name='[Parameter 1]' param-domain-type='range' role='measure' type='quantitative' value='25000.'><calculation class='tableau' formula='25000.' /><range granularity='5000.' max='200000.' min='0.' /></column></datasource>
    <datasource caption='customers' inline='true' name='federated.customers' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='customers' name='textscan.customers'>
            <connection class='textscan' directory="/Users/rishikamethi/Documents/customer-retention-intelligence-platform/tableau/data" filename='customers.csv' password='' server='' />
          </named-connection>
        </named-connections>
        <relation connection='textscan.customers' name='customers.csv' table='[customers#csv]' type='table'>
          <columns character-set='UTF-8' header='yes' locale='en_US' separator=','><column datatype='string' name='customer_unique_id' ordinal='0' /><column datatype='string' name='customer_state' ordinal='1' /><column datatype='date' name='first_purchase_date' ordinal='2' /><column datatype='date' name='last_purchase_date' ordinal='3' /><column datatype='real' name='recency_days' ordinal='4' /><column datatype='integer' name='order_count' ordinal='5' /><column datatype='integer' name='purchase_days' ordinal='6' /><column datatype='real' name='total_revenue' ordinal='7' /><column datatype='real' name='avg_order_value' ordinal='8' /><column datatype='real' name='tenure_days' ordinal='9' /><column datatype='real' name='items_per_order' ordinal='10' /><column datatype='real' name='avg_review_score_observed' ordinal='11' /><column datatype='integer' name='had_late_delivery' ordinal='12' /><column datatype='integer' name='is_repeat_customer' ordinal='13' /><column datatype='string' name='rfm_segment' ordinal='14' /><column datatype='integer' name='r_score' ordinal='15' /><column datatype='integer' name='f_score' ordinal='16' /><column datatype='integer' name='m_score' ordinal='17' /><column datatype='string' name='activity_status' ordinal='18' /><column datatype='string' name='value_tier' ordinal='19' /><column datatype='real' name='return_probability' ordinal='20' /><column datatype='real' name='expected_revenue_180d' ordinal='21' /><column datatype='string' name='risk_tier' ordinal='22' /><column datatype='string' name='customer_group' ordinal='23' /><column datatype='string' name='next_best_action' ordinal='24' /><column datatype='string' name='action_reason' ordinal='25' /><column datatype='real' name='action_cost_brl' ordinal='26' /><column datatype='real' name='priority_score' ordinal='27' /><column datatype='integer' name='priority_rank' ordinal='28' /><column datatype='real' name='cumulative_action_cost_brl' ordinal='29' /><column datatype='date' name='scored_as_of' ordinal='30' /><column datatype='string' name='model_version' ordinal='31' /><column datatype='date' name='acquisition_month' ordinal='32' /><column datatype='real' name='avg_review_score' ordinal='33' /><column datatype='integer' name='late_delivery_count' ordinal='34' /></columns>
        </relation>
      </connection>
      <aliases enabled='yes' />
      <column caption="KPI Revenue (M)" datatype='real' name='[Calculation_kpi_revenue_m]' role='measure' type='quantitative'><calculation class='tableau' formula="ROUND(SUM([total_revenue]) / 1000000, 2)" /></column><column caption="KPI Orders" datatype='integer' name='[Calculation_kpi_orders]' role='measure' type='quantitative'><calculation class='tableau' formula="SUM([order_count])" /></column><column caption="KPI Customers" datatype='integer' name='[Calculation_kpi_customers]' role='measure' type='quantitative'><calculation class='tableau' formula="COUNTD([customer_unique_id])" /></column><column caption="KPI AOV" datatype='real' name='[Calculation_kpi_aov]' role='measure' type='quantitative'><calculation class='tableau' formula="ROUND(SUM([total_revenue]) / SUM([order_count]), 2)" /></column><column caption="KPI Repeat Rate %" datatype='real' name='[Calculation_kpi_repeat_pct]' role='measure' type='quantitative'><calculation class='tableau' formula="ROUND(100 * SUM(IIF([order_count] &gt;= 2, 1, 0)) / COUNT([customer_unique_id]), 2)" /></column><column caption="KPI High-Value Customers" datatype='integer' name='[Calculation_kpi_high_value]' role='measure' type='quantitative'><calculation class='tableau' formula="SUM(IIF([value_tier] = 'High', 1, 0))" /></column><column caption="KPI High-Value Revenue %" datatype='real' name='[Calculation_kpi_high_value_rev_pct]' role='measure' type='quantitative'><calculation class='tableau' formula="ROUND(100 * SUM(IIF([value_tier] = 'High', [total_revenue], 0)) / SUM([total_revenue]), 1)" /></column><column caption="Customers" datatype='integer' name='[Calculation_customer_count]' role='measure' type='quantitative'><calculation class='tableau' formula="COUNTD([customer_unique_id])" /></column><column caption="Lifecycle Stage" datatype='string' name='[Calculation_lifecycle_stage]' role='dimension' type='nominal'><calculation class='tableau' formula="IF [customer_group] = 'Loyal Customer' THEN 'Loyal' ELSEIF [customer_group] = 'New Customer' THEN 'New' ELSEIF [risk_tier] = 'High' THEN 'At-risk' ELSE 'Other one-time' END" /></column><column caption="Revenue Band" datatype='string' name='[Calculation_revenue_band]' role='dimension' type='nominal'><calculation class='tableau' formula="IF [total_revenue] &lt; 50 THEN '1: &lt; R$50' ELSEIF [total_revenue] &lt; 100 THEN '2: R$50-99' ELSEIF [total_revenue] &lt; 200 THEN '3: R$100-199' ELSEIF [total_revenue] &lt; 500 THEN '4: R$200-499' ELSEIF [total_revenue] &lt; 1000 THEN '5: R$500-999' ELSE '6: R$1,000+' END" /></column><column caption="Revenue (R$ M)" datatype='real' name='[Calculation_revenue_m]' role='measure' type='quantitative'><calculation class='tableau' formula="SUM([total_revenue]) / 1000000" /></column><column caption="Avg Return Probability %" datatype='real' name='[Calculation_avg_return_pct]' role='measure' type='quantitative'><calculation class='tableau' formula="ROUND(100 * AVG([return_probability]), 2)" /></column><column caption="Within Budget" datatype='boolean' name='[Calculation_within_budget]' role='dimension' type='nominal'><calculation class='tableau' formula="[cumulative_action_cost_brl] &lt;= [Parameters].[Parameter 1]" /></column><column caption="KPI Customers In Budget" datatype='integer' name='[Calculation_kpi_budget_customers]' role='measure' type='quantitative'><calculation class='tableau' formula="SUM(IIF([cumulative_action_cost_brl] &lt;= [Parameters].[Parameter 1], 1, 0))" /></column><column caption="KPI Budget Spend" datatype='real' name='[Calculation_kpi_budget_spend]' role='measure' type='quantitative'><calculation class='tableau' formula="ROUND(SUM(IIF([cumulative_action_cost_brl] &lt;= [Parameters].[Parameter 1], [action_cost_brl], 0)), 0)" /></column><column caption="KPI High-Value In Budget" datatype='integer' name='[Calculation_kpi_budget_high_value]' role='measure' type='quantitative'><calculation class='tableau' formula="SUM(IIF([cumulative_action_cost_brl] &lt;= [Parameters].[Parameter 1] AND [value_tier] = 'High', 1, 0))" /></column><column caption="KPI Revenue Share In Budget %" datatype='real' name='[Calculation_kpi_budget_rev_pct]' role='measure' type='quantitative'><calculation class='tableau' formula="ROUND(100 * SUM(IIF([cumulative_action_cost_brl] &lt;= [Parameters].[Parameter 1], [total_revenue], 0)) / SUM([total_revenue]), 1)" /></column><column caption="Return Probability %" datatype='real' name='[Calculation_return_prob_pct]' role='dimension' type='ordinal'><calculation class='tableau' formula="ROUND(100 * [return_probability], 2)" /></column><column caption="Customer" datatype='string' name='[Calculation_customer_short_id]' role='dimension' type='nominal'><calculation class='tableau' formula="LEFT([customer_unique_id], 8)" /></column>
      <layout dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
      <style><style-rule element='mark'><encoding attr='color' field='[none:value_tier:nk]' type='palette'><map to='#104281'><bucket>&quot;High&quot;</bucket></map><map to='#2a78d6'><bucket>&quot;Medium&quot;</bucket></map><map to='#86b6ef'><bucket>&quot;Low&quot;</bucket></map></encoding><encoding attr='color' field='[none:risk_tier:nk]' type='palette'><map to='#eb6834'><bucket>&quot;High&quot;</bucket></map><map to='#a8a79f'><bucket>&quot;Medium&quot;</bucket></map><map to='#d6d5cf'><bucket>&quot;Low&quot;</bucket></map></encoding><encoding attr='color' field='[none:activity_status:nk]' type='palette'><map to='#2a78d6'><bucket>&quot;Active&quot;</bucket></map><map to='#eb6834'><bucket>&quot;Cooling&quot;</bucket></map><map to='#a8a79f'><bucket>&quot;Inactive&quot;</bucket></map></encoding><encoding attr='color' field='[none:Calculation_within_budget:nk]' type='palette'><map to='#eb6834'><bucket>true</bucket></map><map to='#d6d5cf'><bucket>false</bucket></map></encoding></style-rule></style>
    </datasource>
    <datasource caption='monthly_revenue' inline='true' name='federated.monthlyrevenue' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='monthly_revenue' name='textscan.monthlyrevenue'>
            <connection class='textscan' directory="/Users/rishikamethi/Documents/customer-retention-intelligence-platform/tableau/data" filename='monthly_revenue.csv' password='' server='' />
          </named-connection>
        </named-connections>
        <relation connection='textscan.monthlyrevenue' name='monthly_revenue.csv' table='[monthly_revenue#csv]' type='table'>
          <columns character-set='UTF-8' header='yes' locale='en_US' separator=','><column datatype='date' name='purchase_month' ordinal='0' /><column datatype='integer' name='orders' ordinal='1' /><column datatype='integer' name='unique_customers' ordinal='2' /><column datatype='real' name='revenue' ordinal='3' /><column datatype='real' name='avg_order_value' ordinal='4' /><column datatype='real' name='items_per_order' ordinal='5' /><column datatype='integer' name='new_customers' ordinal='6' /><column datatype='integer' name='returning_customers' ordinal='7' /><column datatype='real' name='new_customer_revenue' ordinal='8' /><column datatype='real' name='returning_customer_revenue' ordinal='9' /><column datatype='real' name='returning_customer_share' ordinal='10' /><column datatype='real' name='cumulative_revenue' ordinal='11' /><column datatype='boolean' name='is_low_volume_month' ordinal='12' /></columns>
        </relation>
      </connection>
      <aliases enabled='yes' />
      <column caption="Returning Share %" datatype='real' name='[Calculation_returning_share_pct]' role='measure' type='quantitative'><calculation class='tableau' formula="SUM([returning_customer_share]) * 100" /></column><column caption="Revenue (R$ K)" datatype='real' name='[Calculation_revenue_k]' role='measure' type='quantitative'><calculation class='tableau' formula="SUM([revenue]) / 1000" /></column>
      <layout dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
      
    </datasource>
    <datasource caption='cohort_retention' inline='true' name='federated.cohortretention' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='cohort_retention' name='textscan.cohortretention'>
            <connection class='textscan' directory="/Users/rishikamethi/Documents/customer-retention-intelligence-platform/tableau/data" filename='cohort_retention.csv' password='' server='' />
          </named-connection>
        </named-connections>
        <relation connection='textscan.cohortretention' name='cohort_retention.csv' table='[cohort_retention#csv]' type='table'>
          <columns character-set='UTF-8' header='yes' locale='en_US' separator=','><column datatype='string' name='cohort_key' ordinal='0' /><column datatype='date' name='acquisition_month' ordinal='1' /><column datatype='integer' name='months_since_acquisition' ordinal='2' /><column datatype='integer' name='cohort_customers' ordinal='3' /><column datatype='integer' name='active_customers' ordinal='4' /><column datatype='real' name='retention_rate' ordinal='5' /><column datatype='boolean' name='is_small_cohort' ordinal='6' /></columns>
        </relation>
      </connection>
      <aliases enabled='yes' />
      <column caption="Retention %" datatype='real' name='[Calculation_retention_pct]' role='measure' type='quantitative'><calculation class='tableau' formula="ROUND(100 * SUM([retention_rate]), 2)" /></column>
      <layout dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
      
    </datasource>
    <datasource caption='category_performance' inline='true' name='federated.categoryperformance' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='category_performance' name='textscan.categoryperformance'>
            <connection class='textscan' directory="/Users/rishikamethi/Documents/customer-retention-intelligence-platform/tableau/data" filename='category_performance.csv' password='' server='' />
          </named-connection>
        </named-connections>
        <relation connection='textscan.categoryperformance' name='category_performance.csv' table='[category_performance#csv]' type='table'>
          <columns character-set='UTF-8' header='yes' locale='en_US' separator=','><column datatype='string' name='product_category' ordinal='0' /><column datatype='integer' name='items_sold' ordinal='1' /><column datatype='integer' name='orders' ordinal='2' /><column datatype='integer' name='unique_customers' ordinal='3' /><column datatype='integer' name='products_sold' ordinal='4' /><column datatype='real' name='item_revenue' ordinal='5' /><column datatype='real' name='freight_revenue' ordinal='6' /><column datatype='real' name='avg_item_price' ordinal='7' /><column datatype='real' name='item_revenue_share' ordinal='8' /><column datatype='integer' name='revenue_rank' ordinal='9' /><column datatype='real' name='avg_review_score' ordinal='10' /></columns>
        </relation>
      </connection>
      <aliases enabled='yes' />
      <column caption="Item Revenue (R$ K)" datatype='real' name='[Calculation_item_revenue_k]' role='measure' type='quantitative'><calculation class='tableau' formula="SUM([item_revenue]) / 1000" /></column>
      <layout dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
      
    </datasource>
    <datasource caption='model_lift_by_decile' inline='true' name='federated.modelliftbydecile' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='model_lift_by_decile' name='textscan.modelliftbydecile'>
            <connection class='textscan' directory="/Users/rishikamethi/Documents/customer-retention-intelligence-platform/tableau/data" filename='model_lift_by_decile.csv' password='' server='' />
