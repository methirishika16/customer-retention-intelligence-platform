  <worksheets>
    <worksheet name="1.1a KPI Revenue">
      <table>
        <view>
          <datasources><datasource caption='customers' name='federated.customers' /></datasources>
          
          <datasource-dependencies datasource='federated.customers'><column caption="KPI Revenue (M)" datatype='real' name='[Calculation_kpi_revenue_m]' role='measure' type='quantitative'><calculation class='tableau' formula="ROUND(SUM([total_revenue]) / 1000000, 2)" /></column><column caption="Total Revenue" datatype='real' name='[total_revenue]' role='measure' type='quantitative' /><column-instance column='[Calculation_kpi_revenue_m]' derivation='User' name='[usr:Calculation_kpi_revenue_m:qk]' pivot='key' type='quantitative' /></datasource-dependencies>
          
          
          
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view><breakdown value='auto' /></view>
            <mark class='Text' />
            <customized-label><formatted-text><run fontcolor='#52514e' fontsize='11'>Revenue</run><run>Æ&#10;</run><run fontcolor='#0b0b0b' fontsize='26'>R$ </run><run bold='true' fontcolor='#0b0b0b' fontsize='26'>&lt;[federated.customers].[usr:Calculation_kpi_revenue_m:qk]&gt;</run><run fontcolor='#0b0b0b' fontsize='26'>M</run></formatted-text></customized-label>
            <encodings><text column='[federated.customers].[usr:Calculation_kpi_revenue_m:qk]' /></encodings>
            <style><style-rule element='mark'><format attr='mark-color' value='#2a78d6' /></style-rule></style>
          </pane>
        </panes>
        <rows></rows>
        <cols></cols>
      </table>
    </worksheet>
    <worksheet name="1.1b KPI Orders">
      <table>
        <view>
          <datasources><datasource caption='customers' name='federated.customers' /></datasources>
          
          <datasource-dependencies datasource='federated.customers'><column caption="KPI Orders" datatype='integer' name='[Calculation_kpi_orders]' role='measure' type='quantitative'><calculation class='tableau' formula="SUM([order_count])" /></column><column caption="Order Count" datatype='integer' name='[order_count]' role='measure' type='quantitative' /><column-instance column='[Calculation_kpi_orders]' derivation='User' name='[usr:Calculation_kpi_orders:qk]' pivot='key' type='quantitative' /></datasource-dependencies>
          
          
          
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view><breakdown value='auto' /></view>
            <mark class='Text' />
            <customized-label><formatted-text><run fontcolor='#52514e' fontsize='11'>Orders</run><run>Æ&#10;</run><run fontcolor='#0b0b0b' fontsize='26'></run><run bold='true' fontcolor='#0b0b0b' fontsize='26'>&lt;[federated.customers].[usr:Calculation_kpi_orders:qk]&gt;</run><run fontcolor='#0b0b0b' fontsize='26'></run></formatted-text></customized-label>
            <encodings><text column='[federated.customers].[usr:Calculation_kpi_orders:qk]' /></encodings>
            <style><style-rule element='mark'><format attr='mark-color' value='#2a78d6' /></style-rule></style>
          </pane>
        </panes>
        <rows></rows>
        <cols></cols>
      </table>
    </worksheet>
    <worksheet name="1.1c KPI Customers">
      <table>
        <view>
          <datasources><datasource caption='customers' name='federated.customers' /></datasources>
          
          <datasource-dependencies datasource='federated.customers'><column caption="KPI Customers" datatype='integer' name='[Calculation_kpi_customers]' role='measure' type='quantitative'><calculation class='tableau' formula="COUNTD([customer_unique_id])" /></column><column caption="Customer Unique Id" datatype='string' name='[customer_unique_id]' role='dimension' type='nominal' /><column-instance column='[Calculation_kpi_customers]' derivation='User' name='[usr:Calculation_kpi_customers:qk]' pivot='key' type='quantitative' /></datasource-dependencies>
          
          
          
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view><breakdown value='auto' /></view>
            <mark class='Text' />
            <customized-label><formatted-text><run fontcolor='#52514e' fontsize='11'>Customers</run><run>Æ&#10;</run><run fontcolor='#0b0b0b' fontsize='26'></run><run bold='true' fontcolor='#0b0b0b' fontsize='26'>&lt;[federated.customers].[usr:Calculation_kpi_customers:qk]&gt;</run><run fontcolor='#0b0b0b' fontsize='26'></run></formatted-text></customized-label>
            <encodings><text column='[federated.customers].[usr:Calculation_kpi_customers:qk]' /></encodings>
            <style><style-rule element='mark'><format attr='mark-color' value='#2a78d6' /></style-rule></style>
          </pane>
        </panes>
        <rows></rows>
        <cols></cols>
      </table>
    </worksheet>
    <worksheet name="1.1d KPI AOV">
      <table>
        <view>
          <datasources><datasource caption='customers' name='federated.customers' /></datasources>
          
          <datasource-dependencies datasource='federated.customers'><column caption="KPI AOV" datatype='real' name='[Calculation_kpi_aov]' role='measure' type='quantitative'><calculation class='tableau' formula="ROUND(SUM([total_revenue]) / SUM([order_count]), 2)" /></column><column caption="Order Count" datatype='integer' name='[order_count]' role='measure' type='quantitative' /><column caption="Total Revenue" datatype='real' name='[total_revenue]' role='measure' type='quantitative' /><column-instance column='[Calculation_kpi_aov]' derivation='User' name='[usr:Calculation_kpi_aov:qk]' pivot='key' type='quantitative' /></datasource-dependencies>
          
          
          
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view><breakdown value='auto' /></view>
            <mark class='Text' />
            <customized-label><formatted-text><run fontcolor='#52514e' fontsize='11'>Average order value</run><run>Æ&#10;</run><run fontcolor='#0b0b0b' fontsize='26'>R$ </run><run bold='true' fontcolor='#0b0b0b' fontsize='26'>&lt;[federated.customers].[usr:Calculation_kpi_aov:qk]&gt;</run><run fontcolor='#0b0b0b' fontsize='26'></run></formatted-text></customized-label>
            <encodings><text column='[federated.customers].[usr:Calculation_kpi_aov:qk]' /></encodings>
            <style><style-rule element='mark'><format attr='mark-color' value='#2a78d6' /></style-rule></style>
          </pane>
        </panes>
