          <manual-sort column='[federated.customers].[none:Calculation_lifecycle_stage:nk]' direction='ASC'><dictionary><bucket>&quot;Loyal&quot;</bucket><bucket>&quot;New&quot;</bucket><bucket>&quot;At-risk&quot;</bucket><bucket>&quot;Other one-time&quot;</bucket></dictionary></manual-sort>
          
