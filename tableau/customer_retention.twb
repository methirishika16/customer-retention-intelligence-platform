        <relation connection='textscan.modelliftbydecile' name='model_lift_by_decile.csv' table='[model_lift_by_decile#csv]' type='table'>
          <columns character-set='UTF-8' header='yes' locale='en_US' separator=','><column datatype='integer' name='decile' ordinal='0' /><column datatype='integer' name='customers' ordinal='1' /><column datatype='integer' name='returned' ordinal='2' /><column datatype='real' name='predicted_rate' ordinal='3' /><column datatype='real' name='actual_rate' ordinal='4' /><column datatype='real' name='lift' ordinal='5' /><column datatype='real' name='cumulative_capture' ordinal='6' /></columns>
        </relation>
